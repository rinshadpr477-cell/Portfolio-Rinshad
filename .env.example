# ==============================================================================
# RINSHAD PR - PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# All paid services are OPTIONAL. The website runs 100% locally with zero external
# paid API dependencies. Built-in fallbacks exist for AI chat and email submission.

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Anthropic Claude API (for Portfolio AI Assistant)
# ------------------------------------------------------------------------------
# If left blank, the assistant automatically runs on the verified local knowledge engine
# with zero external API calls and zero latency/cost.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Resend Email Delivery (for Direct Server SMTP Contact Submissions)
# ------------------------------------------------------------------------------
# If left blank, the contact form immediately falls back to creating an instant
# pre-filled mail draft to rinshadpr477@gmail.com with zero configuration needed.
# Free Tier: 3,000 emails/month free on Resend.
# RESEND_API_KEY=re_...
# CONTACT_TO_EMAIL=rinshadpr477@gmail.com
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. PUBLIC CONFIGURATION (Safe for Client Bundles)
# ------------------------------------------------------------------------------
# Production deployment domain (used for canonical SEO, sitemap, and Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://rinshad.dev

# Optional: Booking link (e.g. Cal.com or Calendly URL)
# If left blank, defaults to opening an intro call email request.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/rinshadpr
